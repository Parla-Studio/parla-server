# /etc/systemd/system/mirra-lingua.service
# Expects the binary at /opt/mirra-lingua/mirra-lingua-server and a "lingua" system user owning /opt/mirra-lingua.
# The config (mirra-lingua.toml), database (data/) and course files (content/) are created there on first start.
[Unit]
Description=MirraLingua server
After=network.target

[Service]
User=lingua
WorkingDirectory=/opt/mirra-lingua
ExecStart=/opt/mirra-lingua/mirra-lingua-server /opt/mirra-lingua/mirra-lingua.toml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mirra-lingua
PrivateTmp=true

[Install]
WantedBy=multi-user.target
