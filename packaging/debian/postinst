#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if ! getent passwd parla >/dev/null; then
        adduser --system --group --home /var/lib/parla --no-create-home \
            --gecos "Parla server" parla >/dev/null
    fi
    mkdir -p /var/lib/parla
    chown parla:parla /var/lib/parla
    chmod 0750 /var/lib/parla
    # The config is readable by the service, not by everyone.
    chown root:parla /etc/parla/parla.toml
    chmod 0640 /etc/parla/parla.toml

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null || true
        if [ -z "$2" ]; then
            systemctl enable --now parla.service >/dev/null || true
        elif systemctl is-enabled --quiet parla.service; then
            systemctl restart parla.service >/dev/null || true
        fi
    fi
fi

exit 0
