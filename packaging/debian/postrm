#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null || true
fi

# "apt purge" removes all data (database and course files) and the system user.
if [ "$1" = "purge" ]; then
    rm -rf /var/lib/parla /etc/parla
    if getent passwd parla >/dev/null; then
        deluser --system parla >/dev/null 2>&1 || true
    fi
    if getent group parla >/dev/null; then
        delgroup --system parla >/dev/null 2>&1 || true
    fi
fi

exit 0
