#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null || true
fi

# "apt purge" removes all data (database and course files) and the system user.
if [ "$1" = "purge" ]; then
    rm -rf /var/lib/mirra-lingua /etc/mirra-lingua
    if getent passwd mirra-lingua >/dev/null; then
        deluser --system mirra-lingua >/dev/null 2>&1 || true
    fi
    if getent group mirra-lingua >/dev/null; then
        delgroup --system mirra-lingua >/dev/null 2>&1 || true
    fi
fi

exit 0
